// netui.services: status and follow-up actions for optional services, so the
// ACL can name exactly what netui does instead of granting `service list`
// (every service's command line) or `file exec` on their init scripts.
//
//   adblock        adblock-fast's status (procd service data) and whether
//                  netui's last apply is still running.
//   adblock_apply  after a confirmed apply of adblock-fast's config: download
//                  the chosen lists and start (enabled), or stop (disabled).
//                  Downloading takes up to a minute, longer than rpcd lets a
//                  call run, so it runs in the background; poll adblock.
//   portal         openNDS (guest captive portal): running, and its clients
//                  from `ndsctl json`.
//   portal_apply   after a confirmed apply of opennds' config, which has no
//                  reload trigger: restart (enabled) or stop it.
//   portal_auth, portal_deauth {mac}
//                  let one guest through without the portal, or sign one out.
//   tunnel         cloudflared (Cloudflare Tunnel): whether it is set up and
//                  running, its connections to the edge (the metrics server's
//                  /ready), and the last error since it started (its log file).
//                  Never the token: procd's service data has it on the command
//                  line, which is why this is not `service list`.

'use strict';

import { readfile, writefile, mkdir, access, unlink, popen, open } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

const RUN = '/tmp/netui-services';
const ADBLOCK = '/etc/init.d/adblock-fast';
const OPENNDS = '/etc/init.d/opennds';
const NDSCTL = '/usr/bin/ndsctl';
const CLOUDFLARED = '/usr/bin/cloudflared';
const LOG_TAIL = 32768;

function sh(cmd) {
	const p = popen(cmd);
	if (!p)
		return '';
	const out = p.read('all');
	p.close();
	return out ?? '';
}

function parse(s) {
	try {
		return length(s) ? json(s) : null;
	}
	catch (e) {
		return null;
	}
}

const num = (v) => v == null || v == 'null' ? null : +v;

function running(name) {
	const pid = trim(readfile(`${RUN}/${name}.pid`) ?? '');
	return !access(`${RUN}/${name}.exit`) && length(pid) > 0 && !!access(`/proc/${pid}`);
}

// Run a command in the background, recording its pid and exit code.
function spawn(name, cmd) {
	mkdir(RUN, 0700);
	unlink(`${RUN}/${name}.exit`);
	writefile(`${RUN}/${name}.sh`, `#!/bin/sh\necho $$ > ${RUN}/${name}.pid\n${cmd} > ${RUN}/${name}.log 2>&1\necho $? > ${RUN}/${name}.exit\n`);
	system(`/bin/sh ${RUN}/${name}.sh </dev/null >/dev/null 2>&1 &`);
}

const methods = {
	adblock: {
		call: function() {
			if (!access(ADBLOCK))
				return { installed: false };
			const d = connect()?.call('service', 'list', { name: 'adblock-fast' })?.['adblock-fast']?.data;
			return {
				installed: true,
				busy: running('adblock'),
				status: d?.status,
				message: d?.message,
				entries: d?.entries,
				errors: d?.errors ?? [],
				warnings: d?.warnings ?? [],
				version: d?.version,
			};
		}
	},

	adblock_apply: {
		call: function() {
			if (!access(ADBLOCK))
				return { error: 'adblock-fast is not installed' };
			if (running('adblock'))
				return { error: 'ad blocking is still being applied' };
			const on = cursor().get('adblock-fast', 'config', 'enabled') == '1';
			// `dl` downloads the chosen lists again (a restart reuses the cached
			// ones, missing a change of lists) and starts blocking.
			spawn('adblock', `${ADBLOCK} ${on ? 'dl' : 'stop'}`);
			return { result: true };
		}
	},
};

function ndsctl_mac(request, action) {
	const mac = lc(request.args.mac ?? '');
	if (!match(mac, /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/))
		return { error: 'invalid MAC address' };
	const out = trim(sh(`${NDSCTL} ${action} ${mac} 2>&1`));
	return match(out, /not found|failed|error/i) ? { error: out } : { result: true };
}

methods.portal = {
	call: function() {
		if (!access(OPENNDS))
			return { installed: false };
		const up = length(trim(sh('pidof opennds'))) > 0;
		const list = up ? parse(sh(`${NDSCTL} json 2>/dev/null`)) : null;
		const clients = [];
		for (let mac, c in list?.clients ?? {})
			push(clients, {
				mac,
				ip: c.ip,
				state: c.state,
				session_start: num(c.session_start),
				session_end: num(c.session_end),
				last_active: num(c.last_active),
				download: num(c.download_this_session),
				upload: num(c.upload_this_session),
			});
		return { installed: true, busy: running('portal'), running: up, clients };
	}
};

methods.portal_apply = {
	call: function() {
		if (!access(OPENNDS))
			return { error: 'opennds is not installed' };
		if (running('portal'))
			return { error: 'the guest portal is still being applied' };
		const on = cursor().get_first('opennds', 'opennds', 'enabled') != '0';
		spawn('portal', `${OPENNDS} ${on ? 'restart' : 'stop'}`);
		return { result: true };
	}
};

methods.portal_auth = { args: { mac: 'mac' }, call: (r) => ndsctl_mac(r, 'auth') };
methods.portal_deauth = { args: { mac: 'mac' }, call: (r) => ndsctl_mac(r, 'deauth') };

// The end of a file, from its first whole line.
function tail(path, bytes) {
	const f = open(path);
	if (!f)
		return null;
	f.seek(0, 2);
	const size = f.tell();
	f.seek(size > bytes ? size - bytes : 0);
	let out = f.read('all') ?? '';
	f.close();
	if (size > bytes)
		out = substr(out, index(out, '\n') + 1);
	return out;
}

// cloudflared logs one JSON object per line. What happened since the last start:
// the metrics address, the edge locations of registered connections, the last error.
function tunnel_log(path) {
	const lines = split(tail(path, LOG_TAIL) ?? '', '\n');
	let metrics = null, error = null, conns = {};
	for (let l in lines) {
		const e = substr(l, 0, 1) == '{' ? parse(l) : null;
		if (!e)
			continue;
		const msg = e.message ?? '';
		if (msg == 'Starting tunnel') {
			error = null;
			conns = {};
		}
		else if (match(msg, /^Starting metrics server on /))
			metrics = replace(msg, /^Starting metrics server on (.*)\/metrics$/, '$1');
		else if (msg == 'Registered tunnel connection' && e.connIndex != null) {
			conns[e.connIndex] = e.location;
			error = null;
		}
		// Every token-run tunnel logs that the sample config.yml is empty.
		else if ((e.level == 'error' || e.level == 'fatal') && !match(msg, /^Configuration file .* was empty$/))
			error = e.error ? `${msg}: ${e.error}` : msg;
	}
	return { metrics, error, locations: sort(uniq(filter(values(conns), length))) };
}

methods.tunnel = {
	call: function() {
		if (!access(CLOUDFLARED))
			return { installed: false };
		const c = cursor();
		const s = c.get_all('cloudflared', 'config');
		const token = s?.token ?? '';
		// The tunnel's ID is in the token (base64 JSON: account a, tunnel t, secret s).
		const id = length(token) ? parse(b64dec(token) ?? '')?.t : null;
		const inst = connect()?.call('service', 'list', { name: 'cloudflared' })?.cloudflared?.instances?.cloudflared;
		const up = !!inst?.running;
		const log = s?.logfile ? tunnel_log(s.logfile) : { metrics: null, error: null, locations: [] };
		let ready = null, connector = null;
		if (up) {
			// UCI's metrics address if set; else what it logged (it takes the first
			// free port from 20241). /ready answers 503 without a connection.
			let addr = s?.metrics || log.metrics || '127.0.0.1:20241';
			addr = replace(addr, /^(0\.0\.0\.0|localhost|\[::\]|):/, '127.0.0.1:');
			const r = match(addr, /^[0-9a-zA-Z.:-]+$/) ? parse(sh(`uclient-fetch -q -T 2 -O - 'http://${addr}/ready' 2>/dev/null`)) : null;
			ready = +(r?.readyConnections ?? 0);
			connector = r?.connectorId ?? null;
		}
		return {
			installed: true,
			section: !!s,
			enabled: s?.enabled == '1',
			token: length(token) > 0,
			tunnel: type(id) == 'string' ? id : null,
			// A tunnel run from config.yml instead of a token (set up outside netui).
			config_file: !length(token) && s?.enabled == '1',
			running: up,
			connections: ready,
			connector,
			locations: up ? log.locations : [],
			error: log.error,
		};
	}
};

return { 'netui.services': methods };

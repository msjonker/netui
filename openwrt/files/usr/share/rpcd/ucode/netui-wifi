// netui.wifi: what the WiFi hardware can do, and a fix-up after applies.
//
// Installed on the gateway (netui) and on access points (netui-agent); the
// gateway reaches an AP's copy through netui.devices.
//
//   caps   per phy: whether it can put a device on another network by the
//          password it used (AP/VLAN interfaces; ath11k cannot, and hostapd
//          then starts nothing on that radio). The UI maps radio sections to
//          phys with iwinfo info.
//   vlans  after an apply: restart WiFi where a password's network did not
//          come up. 24.10's hostapd re-reads the password file on a reload but
//          not the VLAN file, so a newly added network stays missing (and
//          devices using its password are turned away) until the radio
//          restarts. 25.12 restarts the network itself; this then does nothing.
//
// vlans checks after a pause, in the background: the apply's reload is still
// running when it is called, and rpcd must not wait for it.

'use strict';

import { writefile, lsdir } from 'fs';

function phys() {
	const out = {};
	let nl;
	try {
		nl = require('nl80211');
	}
	catch (e) {
		return out;
	}
	const dump = nl.request(nl.const.NL80211_CMD_GET_WIPHY, nl.const.NLM_F_DUMP, { split_wiphy_dump: true });
	for (let p in dump ?? [])
		if (p.wiphy_name && p.supported_iftypes)
			out[p.wiphy_name] = { ap_vlan: !!p.supported_iftypes.ap_vlan };
	return out;
}

// Restart the WiFi when a running access point's VLAN file names a network
// interface that does not exist. Only running ones count (one still starting
// has not created them yet), and only on phys that can have them at all. The
// lock keeps back-to-back applies from restarting it twice.
const JOB = '/tmp/netui-wifi-vlans.sh';
const SCRIPT = [
	'#!/bin/sh',
	'mkdir /tmp/netui-wifi-vlans.lock 2>/dev/null || exit 0',
	'trap "rmdir /tmp/netui-wifi-vlans.lock" EXIT',
	'sleep 8',
	'need=',
	'for f in /var/run/hostapd-*.vlan; do',
	'	[ -s "$f" ] || continue',
	'	ifn=${f#/var/run/hostapd-}; ifn=${ifn%.vlan}',
	'	phy=$(cat /sys/class/net/$ifn/phy80211/name 2>/dev/null) || continue',
	'	case " $CAPABLE " in *" $phy "*) ;; *) continue ;; esac',
	'	ubus call hostapd.$ifn get_status 2>/dev/null | grep -q \'"status": "ENABLED"\' || continue',
	'	while read -r vid name; do',
	'		[ -n "$name" ] && [ ! -e "/sys/class/net/$name" ] && need=1',
	'	done < "$f"',
	'done',
	'[ -n "$need" ] || exit 0',
	'logger -t netui "restarting WiFi: a network for a WiFi password did not come up"',
	'wifi down; sleep 1; wifi up',
];

const methods = {
	caps: {
		call: function() {
			return { phys: phys() };
		}
	},

	vlans: {
		call: function() {
			const p = phys();
			const capable = filter(keys(p), (n) => p[n].ap_vlan && match(n, /^[A-Za-z0-9_-]+$/));
			if (!length(capable) || !length(filter(lsdir('/var/run') ?? [], (f) => match(f, /^hostapd-.*\.vlan$/))))
				return { result: true };
			writefile(JOB, join('\n', [SCRIPT[0], `CAPABLE='${join(' ', capable)}'`, ...slice(SCRIPT, 1)]) + '\n');
			system(`/bin/sh ${JOB} </dev/null >/dev/null 2>&1 &`);
			return { result: true };
		}
	},
};

return { 'netui.wifi': methods };

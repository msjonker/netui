// netui.devices: the gateway side of netui multi-AP management.
//
// Access points run netui-agent. The browser only ever talks to the gateway;
// this plugin finds pending agents on the LAN, adopts them (a dedicated login
// on the AP, stored here), relays an allowlisted set of ubus calls to them and
// mirrors the gateway's WiFi onto them. Requests to APs go over HTTP to their
// /ubus with uclient-fetch, so nothing stays resident.
//
// rpcd serves one call at a time, so every request to an AP has a short
// timeout and discovery probes all candidates in parallel.

'use strict';

import { readfile, writefile, mkdir, unlink, chmod, popen, lsdir } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

const REGISTRY = '/etc/netui/devices.json';
const RUN = '/tmp/netui';
const NULL_SID = '00000000000000000000000000000000';
// Also the UCI section name on the AP, so no hyphen.
const AP_LOGIN = 'netui_gw';

// What the browser may ask an adopted AP for. The AP's own ACL for the
// gateway login (netui-agent.json) allows the same set and nothing more.
const ALLOWED = {
	'system': ['board', 'info', 'reboot'],
	'network.interface': ['dump'],
	'network.device': ['status'],
	'iwinfo': ['devices', 'info', 'assoclist', 'scan', 'survey', 'freqlist', 'txpowerlist', 'countrylist'],
	'hostapd.*': ['get_status', 'get_clients', 'del_client'],
	'log': ['read'],
	'uci': ['get', 'state', 'changes', 'set', 'add', 'delete', 'rename', 'order', 'apply', 'confirm', 'rollback', 'revert'],
	'netui.agent': ['info', 'ports'],
	'netui.firmware': ['status', 'check', 'upgrade'],
	'netui.packages': ['status', 'install', 'remove'],
};

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function sh(cmd) {
	const p = popen(cmd);
	if (!p)
		return '';
	const out = p.read('all');
	p.close();
	return trim(out ?? '');
}

function load_registry() {
	return json(readfile(REGISTRY) ?? '{"devices":{}}');
}

function save_registry(reg) {
	mkdir('/etc/netui', 0700);
	// Created private before the credentials go in.
	if (!readfile(REGISTRY))
		writefile(REGISTRY, '');
	chmod(REGISTRY, 0600);
	writefile(REGISTRY, sprintf('%.J\n', reg));
}

function sessions() {
	return json(readfile(`${RUN}/sessions.json`) ?? '{}');
}

// { mac: { sid, ip } }: a session and the address that proved it is that
// device (see verified()). Anything else (an older format) counts as none.
function save_sessions(s) {
	mkdir(RUN, 0700);
	if (!readfile(`${RUN}/sessions.json`))
		writefile(`${RUN}/sessions.json`, '');
	chmod(`${RUN}/sessions.json`, 0600);
	writefile(`${RUN}/sessions.json`, sprintf('%J', s));
}

// Whatever answers on port 80 may not be rpcd: a bad reply is no reply.
function parse(s) {
	try {
		return length(s) ? json(s) : null;
	}
	catch (e) {
		return null;
	}
}

function random_secret(n) {
	return sh(`tr -dc 'A-Za-z0-9' </dev/urandom | head -c ${n}`);
}

const IPV4 = /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/;

// One JSON-RPC call to http://ip/ubus (https:// with `tls`, without checking
// the certificate: access points have self-signed ones; it keeps what is sent
// from anyone just listening). The body goes through a 0600 temp file so
// passwords never show up in a process list.
function ubus_at(ip, sid, object, method, args, timeout, tls) {
	if (!match(ip ?? '', IPV4))
		return { error: 'invalid address' };
	mkdir(RUN, 0700);
	const body = sh(`mktemp ${RUN}/req.XXXXXX`);
	chmod(body, 0600);
	writefile(body, sprintf('%J', { jsonrpc: '2.0', id: 1, method: 'call', params: [sid, object, method, args ?? {}] }));
	const url = tls ? `https://${ip}/ubus` : `http://${ip}/ubus`;
	const out = sh(`uclient-fetch -q -T ${timeout ?? 3} -O - ${tls ? '--no-check-certificate ' : ''}--header='Content-Type: application/json' --post-file=${body} ${shellquote(url)} 2>/dev/null`);
	unlink(body);
	const r = parse(out);
	if (type(r?.result) != 'array')
		return r?.error ? { error: r.error.message, code: r.error.code } : { error: 'unreachable' };
	return { status: r.result[0], data: r.result[1] };
}

function own_addresses() {
	return split(sh("ip -4 -o addr show | awk '{print $4}' | cut -d/ -f1"), '\n');
}

// LAN hosts worth probing: DHCP leases plus the LAN's neighbour table. Never
// the WAN side: that is someone else's network.
function lan_hosts() {
	const lan = connect()?.call('network.interface.lan', 'status')?.l3_device ?? 'br-lan';
	const hosts = {};
	for (let line in split(readfile('/tmp/dhcp.leases') ?? '', '\n')) {
		const f = split(line, ' ');
		if (length(f) >= 3)
			hosts[f[2]] = lc(f[1]);
	}
	for (let line in split(sh(`ip -4 neigh show dev ${shellquote(lan)}`), '\n')) {
		const m = match(line, /^([0-9.]+) .*lladdr ([0-9a-f:]+)/);
		if (m && !hosts[m[1]])
			hosts[m[1]] = m[2];
	}
	for (let ip in own_addresses())
		delete hosts[ip];
	return hosts;
}

function ip_num(ip) {
	const o = match(ip ?? '', /^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$/);
	return o ? ((+o[1] << 24) | (+o[2] << 16) | (+o[3] << 8) | +o[4]) : null;
}

// Test for an address in the LAN's IPv4 subnet (always true if it is unknown).
function lan_subnet() {
	const a = connect()?.call('network.interface.lan', 'status')?.['ipv4-address']?.[0];
	const base = ip_num(a?.address), bits = +(a?.mask ?? 0);
	if (base == null || bits < 1 || bits > 32)
		return () => true;
	const mask = (0xffffffff << (32 - bits)) & 0xffffffff;
	return (ip) => ip_num(ip) != null && (ip_num(ip) & mask) == (base & mask);
}

// Current address of a device: its newest DHCP lease by MAC in the LAN
// (adoption switches the AP to DHCP; moving its LAN onto a VLAN changes its
// DHCP client ID, so it can hold two leases for a while; leases on other
// networks are not where it listens), else its neighbour entry, else the last
// one seen.
function address_of(dev) {
	const in_lan = lan_subnet();
	let best = null, newest = -1;
	for (let line in split(readfile('/tmp/dhcp.leases') ?? '', '\n')) {
		const f = split(line, ' ');
		// Expiry 0 is a lease that never expires.
		const exp = +f[0] || 0x7fffffff;
		if (length(f) >= 3 && lc(f[1]) == dev.mac && exp > newest && in_lan(f[2])) {
			best = f[2];
			newest = exp;
		}
	}
	if (best && index(own_addresses(), best) < 0)
		return best;
	for (let ip, mac in lan_hosts())
		if (mac == dev.mac && in_lan(ip))
			return ip;
	return dev.ip;
}

// Probe many hosts at once for netui-agent; returns { ip: info }.
function probe(ips) {
	ips = filter(ips, (ip) => match(ip ?? '', IPV4));
	if (!length(ips))
		return {};
	mkdir(RUN, 0700);
	const dir = sh(`mktemp -d ${RUN}/probe.XXXXXX`);
	const body = `${dir}/body`;
	writefile(body, sprintf('%J', { jsonrpc: '2.0', id: 1, method: 'call', params: [NULL_SID, 'netui.agent', 'info', {}] }));
	let cmd = '';
	for (let ip in ips)
		cmd += `(uclient-fetch -q -T 2 -O ${dir}/${ip} --header='Content-Type: application/json' --post-file=${body} http://${ip}/ubus >/dev/null 2>&1) & `;
	sh(`${cmd} wait`);
	const found = {};
	for (let ip in ips) {
		const r = parse(readfile(`${dir}/${ip}`));
		if (r?.result?.[0] == 0 && r.result[1]?.agent)
			found[ip] = r.result[1];
	}
	sh(`rm -rf ${shellquote(dir)}`);
	return found;
}

function public_view(dev, live, ip) {
	return {
		mac: dev.mac,
		name: dev.name,
		model: live?.model ?? dev.model,
		board_name: dev.board_name,
		ip: ip,
		online: !!live,
		hostname: live?.hostname,
		release: live?.release ?? dev.release,
		agent: live?.agent,
		adopted_at: dev.adopted_at,
		// It holds a key and proves itself before the gateway sends it anything.
		verified: !!dev.key,
	};
}

// Hex SHA-256 of a string (ucode's digest module, else sha256sum on a private file).
function sha256(text) {
	try {
		const d = require('digest');
		if (d?.sha256)
			return d.sha256(text);
	}
	catch (e) {}
	mkdir(RUN, 0700);
	const f = sh(`mktemp ${RUN}/hash.XXXXXX`);
	chmod(f, 0600);
	writefile(f, text);
	const out = sh(`sha256sum < ${f}`);
	unlink(f);
	return match(out ?? '', /^[0-9a-f]{64}/)?.[0];
}

// Whether the device answering at `ip` holds this access point's key (see
// netui.agent prove). Asked before the gateway sends its password or a
// session to an address, so whatever else answers there (a device that
// copied the access point's MAC to get its DHCP lease) learns nothing.
function proves(dev, ip) {
	const nonce = random_secret(32);
	const r = ubus_at(ip, NULL_SID, 'netui.agent', 'prove', { nonce });
	if (r.status != 0 || type(r.data?.proofs) != 'array')
		return false;
	const want = sha256(`netui-prove:${dev.key}:${nonce}:${ip}`);
	return want != null && index(r.data.proofs, want) >= 0;
}

// An access point adopted before keys existed gets one (trusting this login's
// address once), if its agent is new enough to keep it; it has to prove
// itself from then on. An older agent stays unverified (see public_view).
function give_key(dev, ip, sid) {
	const key = random_secret(48);
	const r = ubus_at(ip, sid, 'netui.agent', 'set_key', { key });
	if (r.status != 0 || !r.data?.result)
		return;
	const reg = load_registry();
	if (!reg.devices[dev.mac])
		return;
	reg.devices[dev.mac].key = key;
	save_registry(reg);
	dev.key = key;
}

function login(dev, ip) {
	const r = ubus_at(ip, NULL_SID, 'session', 'login', { username: AP_LOGIN, password: dev.password });
	if (r.status != 0)
		return null;
	const s = sessions();
	s[dev.mac] = { sid: r.data.ubus_rpc_session, ip };
	save_sessions(s);
	if (!dev.key)
		give_key(dev, ip, s[dev.mac].sid);
	return s[dev.mac].sid;
}


function allowed(object, method) {
	const key = match(object, /^hostapd\./) ? 'hostapd.*' : object;
	return index(ALLOWED[key] ?? [], method) >= 0;
}

// Relay one call to an adopted AP, logging in again once if the session expired.
// A session is only used at the address that proved itself for it; at any
// other address the device proves itself again before anything is sent.
function relay(dev, object, method, args) {
	const ip = address_of(dev);
	const known = sessions()[dev.mac];
	let sid = type(known) == 'object' && known.ip == ip ? known.sid : null;
	if (!sid) {
		if (dev.key && !proves(dev, ip))
			return { error: `the device at ${ip} could not prove it is ${dev.name}; nothing was sent to it`, ip: ip };
		sid = login(dev, ip);
	}
	if (!sid)
		return { error: 'login failed', ip: ip };
	let r = ubus_at(ip, sid, object, method, args);
	if (r.code == -32002 || r.status == 6) {
		sid = login(dev, ip);
		if (!sid)
			return { error: 'login failed', ip: ip };
		r = ubus_at(ip, sid, object, method, args);
	}
	return r;
}

// "Office AP" -> "Office-AP": letters, digits and hyphens, as a hostname allows.
function hostname_for(name) {
	const h = replace(replace(trim(name ?? ''), /[^A-Za-z0-9-]+/g, '-'), /^-+|-+$/g, '');
	return substr(length(h) ? h : 'netui-ap', 0, 63);
}

function band_of(radio) {
	return radio?.band ?? (match(radio?.hwmode ?? '', /a/) ? '5g' : '2g');
}

// Higher is better: prefer the newest PHY for client WiFi.
function phy_rank(htmode) {
	return match(htmode ?? '', /^EHT/) ? 4 : match(htmode ?? '', /^HE/) ? 3 : match(htmode ?? '', /^VHT/) ? 2 : 1;
}

// "HE80" on a radio currently at "VHT40" -> "VHT80".
// Widest channel of each PHY family, for radios iwinfo cannot describe.
const FAMILY_MAX = { HT: 40, VHT: 160, HE: 160, EHT: 320 };

// The gateway's width in this radio's PHY family ("HE80" on a WiFi 5 radio
// -> "VHT80"), no wider than the radio supports: an 802.11n radio given
// "HT80" falls back to 20 MHz without 802.11n at all (seen on a TL-WDR4300).
function fit_width(dev, radio, want, current) {
	const family = match(current ?? '', /^[A-Z]+/)?.[0];
	const width = +(match(want ?? '', /[0-9]+$/)?.[0] ?? 0);
	if (!family || !width)
		return want;
	const info = relay(dev, 'iwinfo', 'info', { device: radio });
	let best = 0;
	for (let m in (info.status == 0 ? info.data?.htmodes : null) ?? []) {
		const f = match(m, /^([A-Z]+)([0-9]+)$/);
		if (f?.[1] == family && +f[2] <= width && +f[2] > best)
			best = +f[2];
	}
	if (best)
		return family + best;
	const max = FAMILY_MAX[family] ?? width;
	return family + (width > max ? max : width);
}

// The open "OpenWrt" network a fresh install leaves on each radio. 24.10
// leaves it enabled and turns the radio off instead, so turning the radio on
// for the gateway's networks would start it too, open and bridged to the LAN.
function is_placeholder(s) {
	return (s.mode ?? 'ap') == 'ap' && s.ssid == 'OpenWrt' && (s.encryption ?? 'none') == 'none';
}

function first_network(net) {
	return type(net) == 'array' ? net[0] : split(trim(net ?? ''), ' ')[0];
}

// VLAN of each of the gateway's networks on its LAN bridge (1 for networks on
// a bridge without VLAN filtering), plus the LAN's own.
function gateway_vlans() {
	const uci = cursor();
	const ifaces = {}, bridges = [];
	uci.foreach('network', 'device', (s) => { if (s.type == 'bridge' && s.name) push(bridges, s.name); });
	uci.foreach('network', 'interface', (s) => { ifaces[s['.name']] = s.device ?? ''; });
	const lan_dev = ifaces.lan ?? '';
	let br = bridges[0];
	for (let b in bridges)
		if (lan_dev == b || index(lan_dev, `${b}.`) == 0)
			br = b;
	const vid = {};
	for (let name, d in ifaces)
		if (br && d == br)
			vid[name] = 1;
		else if (br && index(d, `${br}.`) == 0 && match(substr(d, length(br) + 1), /^[0-9]+$/))
			vid[name] = +substr(d, length(br) + 1);
	return { vid, lan: vid.lan ?? 1 };
}

// The gateway's WiFi networks an AP should broadcast too: those on the LAN
// bridge. Networks on another VLAN of it reach the AP only once the AP carries
// that VLAN (netui_<network> on the AP, set up by the UI's network sync), so
// `network` maps a gateway network to the AP's, or returns null.
function gateway_wifi() {
	const uci = cursor();
	const vlans = gateway_vlans();
	const radios = {}, wlans = [];
	uci.foreach('wireless', 'wifi-device', (s) => { radios[s['.name']] = s; });
	uci.foreach('wireless', 'wifi-iface', (s) => {
		// Access points and the mesh backhaul; client (sta) links stay local.
		if ((s.mode != 'ap' && s.mode != 'mesh') || s.disabled == '1')
			return;
		const radio = radios[s.device];
		const net = first_network(s.network);
		push(wlans, {
			section: s['.name'],
			mesh: s.mode == 'mesh',
			band: band_of(radio),
			country: radio?.country,
			channel: radio?.channel,
			htmode: radio?.htmode,
			name: s.ssid ?? s.mesh_id,
			// On the LAN's VLAN: the AP's lan. Elsewhere on the bridge: its netui_ twin.
			network: vlans.vid[net] == vlans.lan ? 'lan' : vlans.vid[net] != null ? `netui_${net}` : null,
			values: s,
		});
	});
	return { wlans };
}

// The LAN bridge's spanning tree settings: on whenever a mesh adds a second
// path between gateway and access point.
function gateway_stp() {
	const uci = cursor();
	let out = null;
	uci.foreach('network', 'device', (s) => {
		if (s.name == 'br-lan')
			out = { stp: s.stp, forward_delay: s.forward_delay };
	});
	return out ?? {};
}

// Client steering: the usteer options netui manages (src/model/steering.ts).
const STEERING = ['band_steering_threshold', 'roam_scan_snr', 'roam_trigger_snr', 'min_snr'];

function sync_steering(dev) {
	let want = null;
	cursor().foreach('usteer', 'usteer', (s) => { want ??= s; });
	if (!want)
		return 0;
	const got = relay(dev, 'uci', 'get', { config: 'usteer' });
	if (got.status != 0)
		return 0;	// usteer not installed on the access point
	for (let name, s in got.data.values)
		if (s['.type'] == 'usteer') {
			const set = {}, unset = [];
			for (let k in STEERING)
				if (want[k] != null && want[k] != s[k])
					set[k] = want[k];
				else if (want[k] == null && s[k] != null)
					push(unset, k);
			if (length(set))
				relay(dev, 'uci', 'set', { config: 'usteer', section: name, values: set });
			if (length(unset))
				relay(dev, 'uci', 'delete', { config: 'usteer', section: name, options: unset });
			return length(set) + length(unset);
		}
	return 0;
}

function sync_stp(dev) {
	const want = gateway_stp();
	const got = relay(dev, 'uci', 'get', { config: 'network' });
	if (got.status != 0)
		return 0;
	for (let name, s in got.data.values)
		if (s['.type'] == 'device' && s.name == 'br-lan') {
			const set = {}, unset = [];
			for (let k in ['stp', 'forward_delay'])
				if (want[k] != null && want[k] != s[k])
					set[k] = want[k];
				else if (want[k] == null && s[k] != null)
					push(unset, k);
			if (length(set))
				relay(dev, 'uci', 'set', { config: 'network', section: name, values: set });
			if (length(unset))
				relay(dev, 'uci', 'delete', { config: 'network', section: name, options: unset });
			return length(set) + length(unset);
		}
	return 0;
}

const SKIP_OPTIONS = ['device', 'ifname', 'macaddr', 'network', 'bssid'];

function sync_wifi(dev) {
	const want = gateway_wifi();
	const got = relay(dev, 'uci', 'get', { config: 'wireless' });
	if (got.status != 0)
		return { error: got.error ?? `uci get failed (${got.status})` };
	const ap = got.data.values;

	// Best radio per band, for client WiFi and the mesh alike. A second radio on
	// the same band is not used as a dedicated mesh backhaul: phys can list
	// "mesh point" without supporting it (ath10k-ct needs rawmode=1, which
	// turns hardware crypto off), so the radio that is known to work is shared.
	const radio_for = {};
	for (let name, s in ap)
		if (s['.type'] == 'wifi-device') {
			const b = band_of(s), cur = radio_for[b];
			if (!cur || phy_rank(s.htmode) > phy_rank(ap[cur].htmode))
				radio_for[b] = name;
		}

	// hostapd's basic build (what stock images ship) has no 802.11v: it
	// rejects bss_transition and then starts nothing on that radio. Leave it
	// out on such an AP, which also removes it there. An agent without
	// netui.packages (before 0.3) cannot say, and gets it as before.
	const pk = relay(dev, 'netui.packages', 'status');
	const basic_wifi = pk.status == 0 && pk.data?.addons?.mesh?.installed === false;

	// Networks the AP carries (netui_<network>, from the UI's network sync).
	const apnet = relay(dev, 'uci', 'get', { config: 'network' });
	const has_net = (n) => n == 'lan' || (apnet.status == 0 && apnet.data.values[n]?.['.type'] == 'interface');
	const skipped = [];
	let copied = 0;

	let changes = 0;
	const keep = {};
	const set = (section, values) => { relay(dev, 'uci', 'set', { config: 'wireless', section, values }); changes++; };
	// Settings per radio this sync uses, applied once after all networks.
	const radio_values = {};

	for (let w in want.wlans) {
		// The basic build has no mesh either: the interface would come up and
		// join nothing, while pinning the radio's channel and width.
		if (w.mesh && basic_wifi)
			continue;
		if (!w.network || !has_net(w.network)) {
			push(skipped, w.name);
			continue;
		}
		const radio = radio_for[w.band];
		if (!radio)
			continue;
		copied++;
		// Sections netui itself created on the gateway keep their name.
		const name = match(w.section, /^netui_/) ? w.section : `netui_${w.section}`;
		keep[name] = true;
		const values = { mode: w.mesh ? 'mesh' : 'ap', network: w.mesh ? 'lan' : w.network, device: radio };
		for (let k, v in w.values)
			if (substr(k, 0, 1) != '.' && index(SKIP_OPTIONS, k) < 0 && !(basic_wifi && k == 'bss_transition'))
				values[k] = v;
		if (!ap[name]) {
			relay(dev, 'uci', 'add', { config: 'wireless', type: 'wifi-iface', name, values });
			changes++;
		}
		else {
			set(name, values);
			// Options switched off on the gateway are removed there, so remove them here too.
			const gone = filter(keys(ap[name]), (k) => substr(k, 0, 1) != '.' && !exists(values, k));
			if (length(gone)) {
				relay(dev, 'uci', 'delete', { config: 'wireless', section: name, options: gone });
				changes++;
			}
		}
		const rv = (radio_values[radio] ??= { disabled: '0' });
		if (w.country)
			rv.country = w.country;
		// Mesh peers must share the channel: follow the gateway's, at the same
		// width in this radio's own PHY family (a WiFi 5 backhaul radio cannot
		// take the gateway's "HE80").
		if (w.mesh) {
			if (w.channel)
				rv.channel = w.channel;
			if (w.htmode)
				rv.htmode = fit_width(dev, radio, w.htmode, ap[radio].htmode);
		}
	}
	for (let radio, rv in radio_values) {
		// A width the radio does not have (written by an older sync) leaves it
		// without 802.11n/ac/ax: fit it.
		if (!rv.htmode && ap[radio].htmode) {
			const fitted = fit_width(dev, radio, ap[radio].htmode, ap[radio].htmode);
			if (fitted != ap[radio].htmode)
				rv.htmode = fitted;
		}
		set(radio, rv);
		// netui runs this AP's WiFi: an enabled placeholder on a radio it uses
		// is never wanted, whether this sync turned the radio on or not.
		for (let name, s in ap)
			if (s['.type'] == 'wifi-iface' && s.device == radio && !match(name, /^netui_/) && s.disabled != '1' && is_placeholder(s))
				set(name, { disabled: '1' });
	}
	for (let name, s in ap)
		if (s['.type'] == 'wifi-iface' && match(name, /^netui_/) && !keep[name]) {
			relay(dev, 'uci', 'delete', { config: 'wireless', section: name });
			changes++;
		}

	// The device's name doubles as its hostname (DHCP leases, logs).
	const host = hostname_for(dev.name);
	const sys = relay(dev, 'uci', 'get', { config: 'system' });
	if (sys.status == 0)
		for (let name, s in sys.data.values)
			if (s['.type'] == 'system' && s.hostname != host) {
				relay(dev, 'uci', 'set', { config: 'system', section: name, values: { hostname: host } });
				changes++;
				break;
			}

	changes += sync_stp(dev);
	changes += sync_steering(dev);

	// Commit without rollback: the changes copied here are already confirmed
	// on the gateway, and a mesh toggle takes the gateway's own bridge through
	// spanning tree, so a confirm would often miss its window and roll back
	// correct settings. Recovery is another sync, which the UI retries.
	if (changes) {
		const applied = relay(dev, 'uci', 'apply', { rollback: false });
		if (applied.status != 0 && applied.status != 5)
			return { error: `apply failed (${applied.status ?? applied.error})` };
	}
	return { result: true, networks: copied, skipped };
}

const methods = {
	list: {
		call: function() {
			const reg = load_registry();
			const ips = {};
			for (let mac, dev in reg.devices)
				ips[mac] = address_of(dev);
			const live = probe(values(ips));
			const out = [];
			for (let mac, dev in reg.devices) {
				const info = live[ips[mac]];
				push(out, public_view(dev, info?.mac == mac ? info : null, ips[mac]));
			}
			return { devices: out };
		}
	},

	discover: {
		call: function() {
			const reg = load_registry();
			const hosts = lan_hosts();
			const found = probe(keys(hosts));
			const pending = [];
			for (let ip, info in found)
				if (!reg.devices[info.mac])
					push(pending, { ip, mac: info.mac, hostname: info.hostname, model: info.model, release: info.release, agent: info.agent, adopted: info.adopted });
			return { devices: pending };
		}
	},

	adopt: {
		args: { ip: 'ip', password: 'password', name: 'name' },
		call: function(request) {
			const a = request.args;
			if (!match(a.ip, /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/))
				return { error: 'invalid address' };
			// HTTPS where the device serves it (stock images with LuCI do), so its
			// root password and the new credentials are not sent in the clear.
			let tls = true;
			let root = ubus_at(a.ip, NULL_SID, 'session', 'login', { username: 'root', password: a.password ?? '' }, 6, true);
			if (root.error == 'unreachable') {
				tls = false;
				root = ubus_at(a.ip, NULL_SID, 'session', 'login', { username: 'root', password: a.password ?? '' });
			}
			if (root.error)
				return { error: root.error };
			if (root.status != 0)
				return { error: 'wrong root password' };
			const sid = root.data.ubus_rpc_session;
			const info = ubus_at(a.ip, sid, 'netui.agent', 'info', {}, 6, tls);
			if (info.status != 0)
				return { error: 'netui-agent is not installed on that device' };

			const me = trim(readfile('/sys/class/net/br-lan/address') ?? '');
			const dev = {
				mac: info.data.mac,
				name: length(a.name) ? a.name : info.data.hostname,
				model: info.data.model,
				board_name: info.data.board_name,
				release: info.data.release,
				ip: a.ip,
				username: AP_LOGIN,
				password: random_secret(32),
				root_password: random_secret(20),
				key: random_secret(48),
				adopted_at: time(),
			};
			const r = ubus_at(a.ip, sid, 'netui.agent', 'adopt', {
				gateway: me, username: dev.username, password: dev.password, root_password: dev.root_password, key: dev.key,
			}, 6, tls);
			if (r.status != 0 || r.data?.error)
				return { error: r.data?.error ?? r.error ?? `adopt failed (${r.status})` };
			// An agent from before keys ignores it: then it stays unverified.
			if (!proves(dev, a.ip))
				delete dev.key;

			const reg = load_registry();
			reg.devices[dev.mac] = dev;
			save_registry(reg);
			return { device: public_view(dev, info.data, a.ip) };
		}
	},

	forget: {
		args: { mac: 'mac' },
		call: function(request) {
			const reg = load_registry();
			const dev = reg.devices[request.args.mac];
			if (!dev)
				return { error: 'unknown device' };
			relay(dev, 'netui.agent', 'release', {});
			delete reg.devices[dev.mac];
			save_registry(reg);
			const s = sessions();
			delete s[dev.mac];
			save_sessions(s);
			return { result: true };
		}
	},

	call: {
		args: { mac: 'mac', object: 'object', method: 'method', args: {} },
		call: function(request) {
			const a = request.args;
			const dev = load_registry().devices[a.mac];
			if (!dev)
				return { error: 'unknown device' };
			if (!allowed(a.object, a.method))
				return { error: 'not allowed' };
			return relay(dev, a.object, a.method, a.args);
		}
	},

	sync: {
		args: { mac: 'mac' },
		call: function(request) {
			const reg = load_registry();
			const targets = request.args.mac ? [reg.devices[request.args.mac]] : values(reg.devices);
			const out = {};
			for (let dev in targets)
				if (dev)
					out[dev.mac] = sync_wifi(dev);
			return { devices: out };
		}
	},

	rename: {
		args: { mac: 'mac', name: 'name' },
		call: function(request) {
			const name = trim(request.args.name ?? '');
			if (!length(name) || length(name) > 64)
				return { error: 'invalid name' };
			const reg = load_registry();
			const dev = reg.devices[request.args.mac];
			if (!dev)
				return { error: 'unknown device' };
			dev.name = name;
			save_registry(reg);
			return sync_wifi(dev);
		}
	},

	credentials: {
		args: { mac: 'mac' },
		call: function(request) {
			const dev = load_registry().devices[request.args.mac];
			return dev ? { username: 'root', password: dev.root_password } : { error: 'unknown device' };
		}
	},
};

return { 'netui.devices': methods };

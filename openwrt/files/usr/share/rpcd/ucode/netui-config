// netui.config: the router's configuration for read-only users, without
// credentials.
//
//   get {config}   like `uci get {config}` (committed values), with every
//                  option that holds a password, key, token or secret
//                  replaced by HIDDEN (so the UI can still tell it is set).
//
// Viewers (ACL group netui-viewer) have no `uci` access at all and read
// through this instead: rpcd's ACL can grant a whole package or nothing, and
// network (WireGuard and VPN keys, PPPoE password), wireless (WiFi and mesh
// keys), ddns (provider passwords) and others hold secrets. Admins keep `uci`.

'use strict';

import { cursor } from 'uci';

const HIDDEN = '********';

// The packages netui reads (the uci read list in netui.json, without
// cloudflared, which is all secret).
const CONFIGS = ['network', 'wireless', 'dhcp', 'firewall', 'system', 'sqm', 'upnpd', 'ddns', 'wifi_schedule',
	'usteer', 'nlbwmon', 'mwan3', 'adblock-fast', 'opennds', 'https-dns-proxy'];

// Option names that hold credentials, in any of these packages (and what
// LuCI's protocols and hostapd's options call them).
function secret(name) {
	if (name == 'public_key')
		return false;
	return !!match(name, /password|passwd|passphrase|secret|token|(^|_)psk$|_key$|^key[0-9]?$|^r[01]kh$|^pin(code)?$|faskey/i);
}

function scrub(section) {
	const out = {};
	for (let k, v in section)
		out[k] = substr(k, 0, 1) != '.' && secret(k) ? (type(v) == 'array' ? [HIDDEN] : HIDDEN) : v;
	return out;
}

const methods = {
	get: {
		args: { config: 'config' },
		call: function(request) {
			const config = request.args.config;
			if (index(CONFIGS, config) < 0)
				return { error: 'not available' };
			// Committed values only (an empty save directory): not changes someone
			// staged with the uci command and never committed.
			const all = cursor(null, '/var/run/netui-config-nosave').get_all(config);
			if (all == null)
				return { error: 'not found' };
			const values = {};
			for (let name, s in all)
				values[name] = scrub(s);
			return { values };
		}
	},
};

return { 'netui.config': methods };

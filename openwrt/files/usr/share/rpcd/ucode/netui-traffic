// netui.traffic: the router's connection table, bounded.
//
//   connections   { total, partial, text }
//
// text: /proc/net/nf_conntrack as is, whole lines, at most MAX_BYTES and
// what TIME_MS allows; the browser parses it (src/model/conntrack.ts).
// total is the kernel's count of tracked connections; partial says the
// table was not read to the end.
//
// luci's getConntrackList parses every entry into an object. rpcd runs one
// call at a time, so with thousands of connections it blocks every other
// request for seconds (minutes on slow routers), and a reply past ubus's size
// limit kills rpcd, which signs every session out. Parsing in ucode at all
// costs 1.5 ms a line on a 560 MHz MIPS router; reading the text a tenth.

'use strict';

import { open, popen } from 'fs';

const TIME_MS = 1000;
// Well inside ubus's message limit (1 MB); about 2,400 connections.
const MAX_BYTES = 524288;

const conntrack = require('netui.conntrack');

function readInt(path) {
	const fd = open(path);
	if (!fd)
		return null;
	const v = +trim(fd.read('all') ?? '');
	fd.close();
	return v;
}

const methods = {
	connections: {
		call: function() {
			const total = readInt('/proc/sys/net/netfilter/nf_conntrack_count');
			let fd = open('/proc/net/nf_conntrack');
			if (!fd)
				fd = popen('/usr/sbin/conntrack -L -o extended 2>/dev/null');
			if (!fd)
				return { error: 'The connection table is not available' };
			const r = conntrack.read(fd, { time_ms: TIME_MS, max_bytes: MAX_BYTES });
			// A pipe is left unread on purpose: conntrack stops on the closed pipe.
			fd.close();
			return { total, partial: r.partial, text: r.text };
		}
	},
};

return { 'netui.traffic': methods };

{
	"netui": {
		"description": "netui management UI",
		"read": {
			"ubus": {
				"network.interface": [ "dump" ],
				"network.device": [ "status" ],
				"iwinfo": [ "devices", "info", "assoclist", "scan", "survey", "freqlist", "txpowerlist", "countrylist" ],
				"hostapd.*": [ "get_status", "get_clients" ],
				"luci-rpc": [ "getBoardJSON", "getDHCPLeases", "getHostHints" ],
				"luci": [ "getTimezones", "getLocaltime", "getUnixtime", "getConntrackList" ],
				"luci.upnp": [ "get_status" ],
				"luci.ddns": [ "get_services_status", "get_ddns_state" ],
				"luci.wireguard": [ "getWgInstances" ],
				"mwan3": [ "status" ],
				"netui.devices": [ "list", "discover" ],
				"netui.firmware": [ "status" ],
				"netui.speedtest": [ "status" ],
				"netui.services": [ "adblock", "portal" ],
				"log": [ "read" ],
				"system": [ "board", "info" ],
				"uci": [ "get", "state", "changes" ],
				"file": [ "exec" ],
				"session": [ "access" ],
				"netui.users": [ "list" ]
			},
			"uci": [ "network", "wireless", "dhcp", "firewall", "system", "sqm", "upnpd", "ddns", "wifi_schedule", "usteer", "nlbwmon", "mwan3", "adblock-fast", "opennds" ],
			"file": {
				"/usr/sbin/nlbw": [ "exec" ]
			},
			"cgi-io": [ "backup" ]
		},
		"write": {
			"ubus": {
				"uci": [ "set", "add", "delete", "rename", "order", "apply", "confirm", "rollback", "revert" ],
				"hostapd.*": [ "del_client" ],
				"luci.upnp": [ "delete_rule" ],
				"luci.wireguard": [ "generateKeyPair", "generatePsk" ],
				"system": [ "reboot" ],
				"netui.devices": [ "adopt", "forget", "call", "sync", "rename", "credentials" ],
				"netui.firmware": [ "check", "upgrade" ],
				"netui.speedtest": [ "start" ],
				"netui.services": [ "adblock_apply", "portal_apply", "portal_auth", "portal_deauth" ],
				"netui.users": [ "add", "remove", "password", "role" ]
			},
			"file": {
				"/etc/init.d/sqm": [ "exec" ],
				"/etc/init.d/ddns": [ "exec" ],
				"/usr/bin/wifi_schedule.sh": [ "exec" ],
				"/tmp/backup.tar.gz": [ "write" ],
				"/sbin/sysupgrade --restore-backup /tmp/backup.tar.gz": [ "exec" ],
				"/usr/bin/etherwake": [ "exec" ],
				"/bin/ping": [ "exec" ],
				"/bin/traceroute": [ "exec" ],
				"/usr/bin/nslookup": [ "exec" ]
			},
			"cgi-io": [ "upload" ],
			"uci": [ "network", "wireless", "dhcp", "firewall", "system", "sqm", "upnpd", "ddns", "wifi_schedule", "usteer", "nlbwmon", "mwan3", "adblock-fast", "opennds" ]
		}
	},
	"netui-viewer": {
		"description": "netui read-only users: everything netui shows, no changes, no backup",
		"read": {
			"ubus": {
				"network.interface": [ "dump" ],
				"network.device": [ "status" ],
				"iwinfo": [ "devices", "info", "assoclist", "scan", "survey", "freqlist", "txpowerlist", "countrylist" ],
				"hostapd.*": [ "get_status", "get_clients" ],
				"luci-rpc": [ "getBoardJSON", "getDHCPLeases", "getHostHints" ],
				"luci": [ "getTimezones", "getLocaltime", "getUnixtime", "getConntrackList" ],
				"luci.upnp": [ "get_status" ],
				"luci.ddns": [ "get_services_status", "get_ddns_state" ],
				"luci.wireguard": [ "getWgInstances" ],
				"mwan3": [ "status" ],
				"netui.devices": [ "list", "discover" ],
				"netui.firmware": [ "status" ],
				"netui.speedtest": [ "status" ],
				"netui.services": [ "adblock", "portal" ],
				"log": [ "read" ],
				"system": [ "board", "info" ],
				"uci": [ "get", "state", "changes" ],
				"file": [ "exec" ],
				"session": [ "access" ]
			},
			"uci": [ "network", "wireless", "dhcp", "firewall", "system", "sqm", "upnpd", "ddns", "wifi_schedule", "usteer", "nlbwmon", "mwan3", "adblock-fast", "opennds" ],
			"file": {
				"/usr/sbin/nlbw": [ "exec" ]
			}
		}
	}
}

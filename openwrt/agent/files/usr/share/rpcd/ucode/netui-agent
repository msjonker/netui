// netui.agent: the access-point side of netui adoption.
//
//   info     anyone on the LAN (unauthenticated ACL): what this device is and
//            whether a gateway has adopted it. No secrets.
//   adopt    root only: create the gateway's login, optionally set a new root
//            password, and turn the device into a bridged access point.
//   release  the gateway's login: forget the gateway (the device stays an AP).
//   ports    the gateway's login: this device's ports (board.json), the
//            switch chip's link states, and the port that leads to the gateway.

'use strict';

import { readfile, writefile, mkdir, unlink, access, popen, lsdir } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

const STATE = '/etc/netui-agent/adopted.json';
const AGENT_VERSION = '@VERSION@';

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function adopted() {
	const raw = readfile(STATE);
	return raw ? json(raw) : null;
}

function lan_mac() {
	return trim(readfile('/sys/class/net/br-lan/address') ?? '') || null;
}

function sh(cmd) {
	const p = popen(cmd);
	if (!p)
		return null;
	const out = p.read('all');
	p.close();
	return trim(out);
}

// The bridge port behind which the bridge learned `mac`: the uplink to the
// gateway, a port or the mesh interface. From the kernel's forwarding table
// (struct __fdb_entry, 16 bytes each), so no `bridge` binary is needed.
function fdb_port(br, mac) {
	const raw = readfile(`/sys/class/net/${br}/brforward`) ?? '';
	const no = {};
	for (let d in lsdir(`/sys/class/net/${br}/brif`) ?? [])
		no[hex(trim(readfile(`/sys/class/net/${br}/brif/${d}/port_no`) ?? ''))] = d;
	for (let i = 0; i + 16 <= length(raw); i += 16) {
		const m = join(':', map([0, 1, 2, 3, 4, 5], (k) => sprintf('%02x', ord(raw, i + k))));
		if (m == mac && !ord(raw, i + 7))
			return no[(ord(raw, i + 12) << 8) | ord(raw, i + 6)];
	}
	return null;
}

// Link state of an swconfig switch's ports, and the port on which it learned
// `mac` (from the address table that ar8xxx switches print; others have none).
// POSIX regex: no (?:) groups.
function switch_state(sw, mac) {
	const out = { name: sw, ports: [], uplink: null };
	for (let line in split(sh(`swconfig dev ${shellquote(sw)} show 2>/dev/null`) ?? '', '\n')) {
		let m = match(line, /^Port ([0-9]+): MAC ([0-9a-f:]+)/);
		if (m) {
			if (m[2] == mac)
				out.uplink = +m[1];
			continue;
		}
		m = match(line, /link: port:([0-9]+) link:(up|down)( speed:([0-9]+)base[^ ]*)?( (full|half)-duplex)?/);
		if (m)
			push(out.ports, { num: +m[1], up: m[2] == 'up', speed: m[4] ? +m[4] : null, duplex: m[6] });
	}
	return out;
}

const methods = {
	info: {
		call: function() {
			const board = connect()?.call('system', 'board') ?? {};
			const state = adopted();
			return {
				agent: AGENT_VERSION,
				mac: lan_mac(),
				hostname: board.hostname,
				model: board.model,
				board_name: board.board_name,
				release: board.release?.description,
				adopted: !!state,
				gateway: state?.gateway,
			};
		}
	},

	adopt: {
		args: { gateway: 'gateway', username: 'username', password: 'password', root_password: 'root_password' },
		call: function(request) {
			const a = request.args;
			// The username doubles as the UCI section name: letters, digits, underscore.
			if (!match(a.username, /^[a-z0-9_]{1,32}$/) || length(a.password) < 16 || !length(a.gateway))
				return { error: 'invalid arguments' };

			const hash = sh(`uhttpd -m ${shellquote(a.password)}`);
			if (!match(hash, /^\$/))
				return { error: 'could not hash the password' };

			const uci = cursor();
			const ok = uci.set('rpcd', a.username, 'login') &&
				uci.set('rpcd', a.username, 'username', a.username) &&
				uci.set('rpcd', a.username, 'password', hash) &&
				uci.set('rpcd', a.username, 'read', ['netui-agent']) &&
				uci.set('rpcd', a.username, 'write', ['netui-agent']) &&
				uci.commit('rpcd');
			if (!ok) {
				uci.revert('rpcd');
				return { error: 'could not create the gateway login' };
			}

			if (length(a.root_password) &&
			    system(`(echo ${shellquote(a.root_password)}; sleep 1; echo ${shellquote(a.root_password)}) | /bin/busybox passwd root >/dev/null 2>&1`) != 0)
				return { error: 'could not set the root password' };

			mkdir('/etc/netui-agent', 0700);
			writefile(STATE, sprintf('%J\n', { gateway: a.gateway, username: a.username, at: time() }));

			// Become a bridged AP after replying: the address may change.
			system('(sleep 2; /usr/libexec/netui-agent/access-point apply) >/dev/null 2>&1 &');
			return { result: true };
		}
	},

	ports: {
		call: function() {
			const board = json(readfile('/etc/board.json') ?? '{}');
			const gw = lc(adopted()?.gateway ?? '');
			const sw = board.switch ? keys(board.switch)[0] : null;
			return {
				network: board.network ?? {},
				switch: board.switch ?? null,
				switch_state: sw ? switch_state(sw, gw) : null,
				uplink: length(gw) ? fdb_port('br-lan', gw) : null,
			};
		}
	},

	release: {
		call: function() {
			const state = adopted();
			if (state?.username) {
				const uci = cursor();
				uci.delete('rpcd', state.username);
				uci.commit('rpcd');
			}
			unlink(STATE);
			return { result: true };
		}
	},
};

return { 'netui.agent': methods };

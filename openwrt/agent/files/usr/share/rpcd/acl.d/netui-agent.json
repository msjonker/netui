{
	"unauthenticated": {
		"description": "netui gateway discovery: what this device is, and proof of its identity; no secrets",
		"read": {
			"ubus": {
				"netui.agent": [
					"info",
					"prove"
				]
			}
		}
	},
	"netui-agent-adopt": {
		"description": "Adopting this device into a netui gateway (root only: root holds every group)",
		"write": {
			"ubus": {
				"netui.agent": [
					"adopt"
				]
			}
		}
	},
	"netui-agent": {
		"description": "The netui gateway managing this access point",
		"read": {
			"ubus": {
				"netui.agent": [
					"info",
					"ports"
				],
				"netui.firmware": [
					"status"
				],
				"system": [
					"board",
					"info"
				],
				"network.interface": [
					"dump"
				],
				"network.device": [
					"status"
				],
				"iwinfo": [
					"devices",
					"info",
					"assoclist",
					"scan",
					"survey",
					"freqlist",
					"txpowerlist",
					"countrylist"
				],
				"hostapd.*": [
					"get_status",
					"get_clients"
				],
				"log": [
					"read"
				],
				"uci": [
					"get",
					"state",
					"changes"
				],
				"netui.packages": [
					"status"
				]
			},
			"uci": [
				"network",
				"wireless",
				"system",
				"dhcp",
				"usteer"
			]
		},
		"write": {
			"ubus": {
				"netui.agent": [
					"release",
					"set_key"
				],
				"netui.firmware": [
					"check",
					"upgrade"
				],
				"uci": [
					"set",
					"add",
					"delete",
					"rename",
					"order",
					"apply",
					"confirm",
					"rollback",
					"revert"
				],
				"hostapd.*": [
					"del_client"
				],
				"system": [
					"reboot"
				],
				"netui.packages": [
					"install",
					"remove"
				]
			},
			"uci": [
				"wireless",
				"system",
				"network",
				"usteer"
			]
		}
	}
}
